<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MeuAppAvalonia.ConfiguracaoSecretWindow"
        Title="Configuração do secret"
        Width="760" Height="620"
        WindowStartupLocation="CenterOwner"
        CanResize="False">
    <Window.Styles>
        <Style Selector="TextBlock.titulo-secao">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#17324D" />
        </Style>
        <Style Selector="TextBlock.rotulo-campo">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#53677A" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style Selector="TextBox">
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="Padding" Value="12,10" />
        </Style>
        <Style Selector="Button.botao-primario">
            <Setter Property="Background" Value="#13795B" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Padding" Value="20,10" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.botao-secundario">
            <Setter Property="Background" Value="#1769AA" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.botao-secundario:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                       Button.botao-primario:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                       Button.botao-secundario:pressed /template/ ContentPresenter#PART_ContentPresenter,
                       Button.botao-primario:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Opacity" Value="0.96" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*" Background="#F4F7F9">
        <Border Grid.Row="0" Background="#17324D" Padding="32,24">
            <StackPanel Spacing="6">
                <TextBlock Text="CONFIGURAÇÃO" FontSize="12" FontWeight="Bold" Foreground="#7BDCB5" />
                <TextBlock Text="Gerar secret do cliente" FontSize="30" FontWeight="SemiBold" Foreground="White" />
                <TextBlock Text="Preencha os dados da empresa e do dispositivo para montar o link do endpoint e gerar o secret." Foreground="#D7E5ED" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" Padding="28">
            <StackPanel Spacing="20" MaxWidth="650" HorizontalAlignment="Stretch">
                <Border Background="White" BorderBrush="#DCE5EA" BorderThickness="1" CornerRadius="10" Padding="20">
                    <StackPanel Spacing="18">
                        <TextBlock Text="Dados do dispositivo" Classes="titulo-secao" />

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="16" RowDefinitions="Auto,Auto">
                            <StackPanel Grid.Column="0" Grid.Row="0">
                                <TextBlock Text="Client ID" Classes="rotulo-campo" />
                                <TextBox x:Name="ClientIdTextBox" TextChanged="Campo_Alterado" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Grid.Row="0">
                                <TextBlock Text="Nome da empresa" Classes="rotulo-campo" />
                                <TextBox x:Name="EmpresaNomeTextBox" TextChanged="Campo_Alterado" />
                            </StackPanel>

                            <StackPanel Grid.Column="0" Grid.Row="1" Margin="0,8,0,0">
                                <TextBlock Text="CNPJ" Classes="rotulo-campo" />
                                <TextBox x:Name="EmpresaCnpjTextBox" TextChanged="Campo_Alterado" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Grid.Row="1" Margin="0,8,0,0">
                                <TextBlock Text="Nome do dispositivo" Classes="rotulo-campo" />
                                <TextBox x:Name="DeviceNameTextBox" TextChanged="Campo_Alterado" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Spacing="6">
                            <TextBlock Text="URL do endpoint" Classes="rotulo-campo" />
                            <TextBox x:Name="UrlTextBox" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" Height="90" />
                        </StackPanel>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Token de acesso (24h)" Classes="rotulo-campo" />
                                <TextBox x:Name="TokenAcessoTextBox" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" Height="110" />
                            </StackPanel>
                            <StackPanel Spacing="6">
                                <TextBlock Text="Válido até" Classes="rotulo-campo" />
                                <TextBox x:Name="TokenExpiraEmTextBox" IsReadOnly="True" Text="" Height="110" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button Content="Gerar formato"
                                    Classes="botao-secundario"
                                    Click="GerarFormatoButton_Click" />
                            <Button Content="Gerar token 24h"
                                    Classes="botao-secundario"
                                    Click="GerarToken24hButton_Click" />
                            <Button Content="Copiar token"
                                    Classes="botao-secundario"
                                    Click="CopiarTokenButton_Click" />
                            <Button Content="Salvar configuração"
                                    Classes="botao-primario"
                                    Click="SalvarConfiguracaoButton_Click" />
                            <Button Content="Abrir no navegador"
                                    Classes="botao-secundario"
                                    Click="AbrirNoNavegadorButton_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Background="White" BorderBrush="#DCE5EA" BorderThickness="1" CornerRadius="10" Padding="20">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Resposta do endpoint" Classes="titulo-secao" />
                        <TextBox x:Name="SecretResultadoTextBox"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 Height="180"
                                 Text="A resposta enviada pelo end point aparecerá aqui." />
                        <TextBlock x:Name="MensagemStatus" Foreground="#B42318" Text="" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
